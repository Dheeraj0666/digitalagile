# Proof-of-concept runtime for pre-reviewed repositories ONLY.
# Node is installed for npm builds. The process runner is NOT an isolation boundary.
FROM node:22-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH \
    HOME=/tmp
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-pip git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
COPY frontend_agent ./frontend_agent
COPY agentcore ./agentcore
COPY templates ./templates
COPY prompts ./prompts
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir '.[agentcore]'
RUN mkdir -p /tmp/digitalagile-npm-cache && chown -R 10001:10001 /app /tmp/digitalagile-npm-cache
USER 10001:10001
EXPOSE 8080
CMD ["python", "-m", "agentcore.app"]
