# Never commit your real .env file.
# Choose one: anthropic | bedrock | ollama
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929
# If using Bedrock, comment MODEL_PROVIDER=anthropic and use:
# MODEL_PROVIDER=bedrock
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
AWS_PROFILE=
# If using Ollama:
OLLAMA_MODEL_ID=llama3.1
OLLAMA_HOST=http://localhost:11434
# POC only - enable networked installs explicitly via CLI --allow-network-install
